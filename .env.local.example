# مفتاح Google Gemini API لتوليد الحلول آليا من ملفات التمارين والمراجع
# احصل عليه مجانا من: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# اسم نموذج Gemini المستخدم (اختياري)
GEMINI_MODEL=gemini-2.5-flash

# كلمة مرور لوحة تحكم الإدارة (/admin)
ADMIN_PASSWORD=admin2026

# يتم إضافته تلقائيا عند تفعيل Vercel Blob Storage من لوحة Vercel لحفظ الطلبات والملفات بشكل دائم
BLOB_READ_WRITE_TOKEN=
