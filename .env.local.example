# مفتاح Google Gemini API لتوليد الحلول آليا من ملفات التمارين والمراجع
# احصل عليه مجانا من: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# اسم نموذج Gemini المستخدم (اختياري)
GEMINI_MODEL=gemini-3.8-flash

# كلمة مرور لوحة تحكم الإدارة (/admin)
ADMIN_PASSWORD=admin2026

# قاعدة بيانات Firebase Firestore (انسخ محتوى ملف Service Account JSON هنا كسطر واحد)
FIREBASE_SERVICE_ACCOUNT_KEY=

# مخزن الملفات الكبيرة على Vercel (يُضاف تلقائيا عند ربط Vercel Blob Storage بالمشروع)
BLOB_READ_WRITE_TOKEN=
